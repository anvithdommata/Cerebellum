# Copy this file to .env.local and fill in real values, OR use the in-app
# Settings tab (http://localhost:3000 -> Settings) which writes to
# .env.local for you and applies keys immediately without a restart.
#
# .env.local is gitignored — never commit real keys.

# MARKETAUX_API_KEY: financial news with per-ticker sentiment scores built in.
# Free tier: 100 requests/day, no credit card. Powers the News & NLP engine.
# Get one at https://www.marketaux.com/register
MARKETAUX_API_KEY=""

# GEMINI_API_KEY: legacy — was used to score GDELT headlines. Now unused
# since Marketaux returns native sentiment. Left here as a placeholder for
# future features (e.g. LLM-based earnings-call summarization).
GEMINI_API_KEY=""

# FMP_API_KEY: Financial Modeling Prep — daily prices + fundamentals.
# Powers the Technical and Fundamental engines. Required for most of the
# platform to produce anything meaningful.
# Get one at https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=""

# EIA_API_KEY: free US energy data. Required only for EIA ingestion.
# Get one at https://www.eia.gov/opendata/register.php
EIA_API_KEY=""

# OPENFDA_API_KEY: optional key for higher openFDA request limits. The public
# API still works without it, so leave blank if you do not need extra quota.
OPENFDA_API_KEY=""

# FLASHALPHA_API_KEY: optional FlashAlpha GEX access. Used only for the
# rate-capped weekly options/GEX snapshot schedule.
FLASHALPHA_API_KEY=""

# SAM_API_KEY: SAM.gov federal contract awards. Powers the Government &
# Policy engine's contract-anomaly detection. Optional — the engine reports
# zero confidence (not a fabricated score) until this is set.
# Get one at https://sam.gov/data-services
SAM_API_KEY=""

# CONGRESS_API_KEY: Congress.gov legislative bill tracking. Feeds the
# Government & Policy engine's bill-matching signal. Optional.
# Get one at https://api.congress.gov/sign-up/
CONGRESS_API_KEY=""

# SEC_USER_AGENT: not a secret — SEC EDGAR requires a compliant
# "Company Name email@domain.com" User-Agent on every request. Required.
SEC_USER_AGENT=""

# CEREBELLUM_DB_PATH: optional override for the SQLite file location.
# Defaults to ./data/cerebellum.db
CEREBELLUM_DB_PATH=""

# APP_URL: the URL this app is hosted at (used by AI Studio's Cloud Run
# deploys; not required for local dev).
APP_URL=""
